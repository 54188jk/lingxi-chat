<?xml version="1.0" encoding="utf-8"?>
<!-- 输入栏：胶囊白卡抬起来 5dp，顶缘一条高光；聚焦态另见 bg_input_bar_focused -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="2.5dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow_near" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/surface_dim"
                android:startColor="@color/input_bg"
                android:type="linear" />
            <stroke
                android:width="0.5dp"
                android:color="@color/card_stroke" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:gravity="top"
        android:height="1dp"
        android:left="20dp"
        android:right="20dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_highlight" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
