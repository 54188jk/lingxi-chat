<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9263350" />
            <stroke android:width="0.5dp" android:color="#806EA8FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3141926" />
            <stroke android:width="0.5dp" android:color="#336EA8FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
