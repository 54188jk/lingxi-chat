<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>

    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="top|start"
        android:left="-140dp"
        android:top="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:startColor="#3D3D74E0"
                android:centerColor="#1A2B5AA8"
                android:endColor="#000C0E14" />
        </shape>
    </item>

    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="bottom|end"
        android:right="-120dp"
        android:bottom="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:startColor="#336EA8FF"
                android:centerColor="#142B4A80"
                android:endColor="#000C0E14" />
        </shape>
    </item>

    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="center|end"
        android:right="-100dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:startColor="#1F6EE7F9"
                android:endColor="#000C0E14" />
        </shape>
    </item>

</layer-list>
