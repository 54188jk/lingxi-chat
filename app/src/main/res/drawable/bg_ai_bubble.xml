<?xml version="1.0" encoding="utf-8"?>
<!-- AI 气泡：白底 + 发丝描边 + 淡投影，左上收小做尾巴 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow" />
            <corners
                android:topLeftRadius="7dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="19dp"
                android:bottomRightRadius="19dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_ai" />
            <stroke android:width="0.5dp" android:color="@color/card_stroke" />
            <corners
                android:topLeftRadius="6dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
