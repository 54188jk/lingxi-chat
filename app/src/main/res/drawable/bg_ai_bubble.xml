<?xml version="1.0" encoding="utf-8"?>
<!-- AI 气泡：抬起来 5dp，左上收小做尾巴，长按有墨色涟漪 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_soft">
    <item
        android:id="@android:id/mask"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp"
                android:topLeftRadius="8dp"
                android:topRightRadius="20dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_shadow" />
                    <corners
                        android:bottomLeftRadius="22dp"
                        android:bottomRightRadius="22dp"
                        android:topLeftRadius="12dp"
                        android:topRightRadius="22dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_shadow_near" />
                    <corners
                        android:bottomLeftRadius="21dp"
                        android:bottomRightRadius="21dp"
                        android:topLeftRadius="10dp"
                        android:topRightRadius="21dp" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/surface_dim"
                        android:startColor="@color/card_ai"
                        android:type="linear" />
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/card_stroke" />
                    <corners
                        android:bottomLeftRadius="20dp"
                        android:bottomRightRadius="20dp"
                        android:topLeftRadius="8dp"
                        android:topRightRadius="20dp" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:gravity="top"
                android:height="1dp"
                android:left="18dp"
                android:right="18dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_highlight" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
