<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>

    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="top|start"
        android:left="-140dp"
        android:top="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:startColor="#1FF43F5E"
                android:endColor="#00F3F7F5" />
        </shape>
    </item>

    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="bottom|end"
        android:right="-120dp"
        android:bottom="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:startColor="#1AF43F5E"
                android:endColor="#00F3F7F5" />
        </shape>
    </item>

</layer-list>
