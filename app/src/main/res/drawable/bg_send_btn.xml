<?xml version="1.0" encoding="utf-8"?>
<!-- 发送键：圆牌抬起来 3dp，边缘一圈发丝，按下有水波 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_solid_ripple">
    <item
        android:id="@android:id/mask"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item
                android:left="2dp"
                android:right="2dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/card_shadow_near" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:endColor="@color/user_bubble_end"
                        android:startColor="@color/btn_solid"
                        android:type="linear" />
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/card_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
