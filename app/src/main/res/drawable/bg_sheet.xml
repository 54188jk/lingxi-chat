<?xml version="1.0" encoding="utf-8"?>
<!-- 面板底：往上露出 6dp 软影，把面板从页面底抬起来；顶缘一条高光做接缝 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow" />
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
        </shape>
    </item>
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/sheet_bg"
                android:startColor="@color/surface"
                android:type="linear" />
            <stroke
                android:width="0.5dp"
                android:color="@color/card_stroke" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="28dp"
        android:right="28dp"
        android:top="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_highlight" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
