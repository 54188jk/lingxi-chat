<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="设置"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_divider" />

        <!-- ============ 三步上手 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:lineSpacingMultiplier="1.5"
            android:padding="14dp"
            android:text="第一次用，三步就够了\n1. 在「模型配置」里添加一套 API 地址和 Key（DeepSeek、Kimi 等国内服务都能直接填）\n2. 回到聊天页，像平时聊天一样提问\n3. 想发图片、文件或让 AI 替你操作手机，点输入框左边的 +"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- ============ 外观 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="外观与输入" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主题"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="字号"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spFontScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="10dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="回车直接发送"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关闭后回车换行，Shift+回车始终换行"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swEnterSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 模型配置 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="模型配置（必做）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="兼容 OpenAI 格式的服务都能接入（DeepSeek、OpenAI、通义、智谱等），点配置可编辑，长按设为默认或删除。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/btnAddModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:text="+ 添加模型配置"
            android:textColor="@color/btn_outline_fg"
            android:textAllCaps="false"
            android:backgroundTint="@null"
            android:background="@drawable/bg_btn_white" />

        <Button
            android:id="@+id/btnFreeModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_white"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_sparkle"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="没有 Key？点这里获取免费模型网址"
            android:textColor="@color/btn_outline_fg"
            android:textAllCaps="false" />

        <!-- ============ AI 角色 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="AI 角色" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRoles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/btnAddRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:text="+ 添加自定义角色"
            android:textColor="@color/btn_outline_fg"
            android:textAllCaps="false"
            android:backgroundTint="@null"
            android:background="@drawable/bg_btn_white" />

        <!-- ============ 免费语音识别 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="语音输入" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="设备自带语音识别时直接用本机能力（不花流量）；不支持的设备可添加下方免费语音服务，注册即送免费额度，粘贴 Key 后聊天页麦克风即可语音输入。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAddFreeStt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="+ 添加免费语音服务"
            android:textColor="@color/btn_outline_fg"
            android:textAllCaps="false"
            android:backgroundTint="@null"
            android:background="@drawable/bg_btn_white" />

        <!-- ============ 系统操控 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="手机操控（可选）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.4"
            android:text="不开这个功能也完全不影响聊天。开启后，你在聊天页说一句话，灵犀就能替你操作手机。
· 前台：读屏并替你点按、滑动、输入，操作时请先别碰屏幕
· 后台：不读屏也不碰屏幕，只发指令（打开应用、打开链接、查信息），你可以照常玩手机
· 通道：默认用系统无障碍，免 root；装了 Root 或 Shizuku 可以在下面换
· 隐私：前台模式的屏幕文字（以及开启截图时的画面）会发送给你配置的模型服务商，这是云端模型的工作方式，不是本机处理；密码框内容一律不回传，支付类按钮默认拦截，随时可以急停"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="操作方式"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spControlMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp" />

            <TextView
                android:id="@+id/tvControlModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="前台接管：灵犀读屏并替你看清、点按、输入，期间请尽量不要碰屏幕。"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="操控通道"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spControlBackend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最多步数"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spControlSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="10dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="动作节奏"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spControlPace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="视觉模型回传截图"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关闭后只回传读屏文字，省流量也少暴露画面"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swControlVision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="禁止点支付/转账类按钮"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="遇到支付页自动拦下，交还给你自己点"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swControlPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvControlStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="通道状态检测中…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_white"
                android:backgroundTint="@null"
                android:gravity="center"
                android:text="去系统无障碍里开启灵犀AI"
                android:textAllCaps="false"
                android:textColor="@color/btn_outline_fg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRequestShizuku"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_white"
                    android:backgroundTint="@null"
                    android:gravity="center"
                    android:text="向 Shizuku 申请授权"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_outline_fg" />

                <Button
                    android:id="@+id/btnControlTest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_white"
                    android:backgroundTint="@null"
                    android:gravity="center"
                    android:text="试读当前屏幕"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_outline_fg" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 数据备份 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="数据备份" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="换手机、重装或更新签名后，可先备份全部会话再恢复，避免聊天记录丢失。备份文件仅保存在你选择的位置。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackupSessions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_white"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_share"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="备份全部会话"
                android:textColor="@color/btn_outline_fg"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnRestoreSessions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_white"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_history"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="从文件恢复"
                android:textColor="@color/btn_outline_fg"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSessionBackupInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:text="当前本机共 0 个会话"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- ============ 更多 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="更多" />

        <Button
            android:id="@+id/btnHistoryVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_btn_white"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_history"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="历史版本"
            android:textColor="@color/btn_outline_fg"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:text="历史版本从官方公开仓库读取，免费、无需任何 Key。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- ============ 历史安装包 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="历史安装包" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="只有在「历史版本」里下载安装包时才会在这里留一份，方便以后查看或重装（普通更新不存档）。你可以随时在文件管理器里打开「历史记录」文件夹点开安装，系统清理缓存也不会丢。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvArchiveInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:text="保存位置：内部储存/历史记录"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnArchiveList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_white"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_history"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="已存安装包"
                android:textColor="@color/btn_outline_fg"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnArchiveLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_white"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_attach"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="改保存位置"
                android:textColor="@color/btn_outline_fg"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- ============ 关于 ============ -->
        <TextView
            style="@style/SettingsSection"
            android:text="关于" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="图标"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="灵犀AI"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="当前版本"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检查更新"
                android:textColor="@color/btn_solid_fg"
                android:textAllCaps="false"
                android:backgroundTint="@null"
                android:background="@drawable/bg_btn_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:text="联网搜索已内置（DuckDuckGo），免费、无需任何配置。API Key 等所有配置仅保存在本机，不会上传。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
