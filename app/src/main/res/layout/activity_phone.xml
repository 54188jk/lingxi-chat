<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deskRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 壁纸：内置渐变或用户自己选的一张图，光晕叠在它上面 -->
    <ImageView
        android:id="@+id/deskWall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="壁纸"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_wall_crimson" />

    <!-- 壁纸光晕：底色由机桌主题给，这里只画漂移的柔光 -->
    <com.lingxi.chat.DeskGlowView
        android:id="@+id/glowDesk"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/deskContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- 时钟小组件：顺便说清现在能不能聊 -->
        <LinearLayout
            android:id="@+id/cardDeskWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_desk_glass"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvBigClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.03"
                android:text="09:41"
                android:textColor="@color/desk_fg"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeskDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="10月10日 周五 · 电量 78%"
                android:textColor="@color/desk_fg_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvWidgetNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="当前模型：还没配置"
                android:textColor="@color/desk_fg_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 这台「手机」上唯一的软件 -->
        <LinearLayout
            android:id="@+id/appNuoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_nav_key"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_desk_app">

                <ImageView
                    android:id="@+id/ivNuojiIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:contentDescription="糯叽"
                    android:src="@mipmap/ic_launcher" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/desk_fg"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 桌面上直接摆着的入口（代码按条目生成，四个一行） -->
        <LinearLayout
            android:id="@+id/llDeskGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical" />

        <!-- Dock：四个最常用的去处 -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_desk_glass"
            android:orientation="horizontal"
            android:padding="10dp">

            <FrameLayout
                android:id="@+id/dockHistory"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_desk_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="历史会话"
                    android:src="@drawable/ic_history"
                    app:tint="@color/desk_fg" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/dockSettings"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_desk_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="设置"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/desk_fg" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/dockFiles"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_desk_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="文件与文件夹"
                    android:src="@drawable/ic_folder"
                    app:tint="@color/desk_fg" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/dockControl"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_desk_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="操控台"
                    android:src="@drawable/ic_control"
                    app:tint="@color/desk_fg" />
            </FrameLayout>
        </LinearLayout>

        <!-- 三键 -->
        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_desk_nav"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/btnNavBack"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_key"
                android:contentDescription="返回"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_back"
                app:tint="@color/desk_fg_dim" />

            <ImageView
                android:id="@+id/btnNavHome"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_key"
                android:contentDescription="回到桌面"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/desk_fg_dim" />

            <ImageView
                android:id="@+id/btnNavRecent"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_key"
                android:contentDescription="最近使用"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_recent"
                app:tint="@color/desk_fg_dim" />
        </LinearLayout>
    </LinearLayout>

    <!-- 多任务：最近打开过的页面 -->
    <LinearLayout
        android:id="@+id/panelRecents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_desk_scrim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近使用"
            android:textColor="@color/desk_fg_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/llRecents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/bg_desk_glass_strong"
            android:orientation="vertical"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="点卡片继续，点外面关掉"
            android:textColor="@color/desk_fg_dim"
            android:textSize="11sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
