<?xml version="1.0" encoding="utf-8"?>
<!-- 免费模型接入页：复制并打开官网 + 把接入要填的三样东西说清楚 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="免费模型接入"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGoSettings"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_white"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="去填 Key"
            android:textColor="@color/btn_outline_fg"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:lineSpacingMultiplier="1.45"
                android:paddingBottom="21dp"
                android:padding="16dp"
                android:text="没有 API Key 也能用起来\n\n下面这个站是 OpenAI 兼容的大模型聚合平台，注册后会送额度，一个 Key 可以调用站内几十个模型。糯叽不收集任何东西，Key 只存在你手机本机。"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                style="@style/SettingsSection"
                android:layout_marginStart="0dp"
                android:text="第一步　拿网址" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:lineSpacingMultiplier="1.4"
                android:paddingBottom="19dp"
                android:padding="14dp"
                android:text="点下面的按钮，官网地址会立刻复制到剪贴板，并自动在浏览器里打开。到网页上注册一个账号即可。"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCopyAndOpen"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_share"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="复制网址并打开浏览器"
                android:textColor="@color/btn_solid_fg"
                android:textSize="15sp"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvSiteState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="还没复制过。官网：https://vsllm.cc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                style="@style/SettingsSection"
                android:layout_marginStart="0dp"
                android:text="第二步　拿到 Key" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:lineSpacingMultiplier="1.45"
                android:paddingBottom="19dp"
                android:padding="14dp"
                android:text="在官网的控制台里新建一个令牌，复制它以 sk- 开头的那串字符。\n\n这一串只贴到糯叽的设置里，不会写进应用、也不会上传到任何地方。"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                style="@style/SettingsSection"
                android:layout_marginStart="0dp"
                android:text="第三步　回到应用填三项" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingBottom="19dp"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/rowBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="服务地址"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvBaseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="https://vsllm.cc/v1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:id="@+id/rowModelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="模型名称（不确定就填 auto，站内会自动挑可用模型）"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvModelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="auto"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnApplyPreset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_white"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="先把地址存进设置"
                android:textColor="@color/btn_outline_fg"
                android:textSize="14sp"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="点任意一行可以直接复制。按上面这个按钮，糯叽会直接把这条配置建好并设为当前使用的配置，你只要在设置里把 Key 粘进对应输入框即可。"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_note_card"
                android:lineSpacingMultiplier="1.4"
                android:padding="14dp"
                android:text="说明：这个平台由第三方运营，注册协议、额度多少、模型是否收费都由它自己决定，与本应用无关。用着不合适可以在 设置 → 模型配置 里换成 DeepSeek、通义、Kimi 等任意 OpenAI 兼容服务。"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
