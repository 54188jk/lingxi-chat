<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗内的说明卡片底：比弹窗面板再深一档，靠发丝描边分层 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/surface_dim"
        android:startColor="@color/code_bg"
        android:type="linear" />
    <stroke
        android:width="0.5dp"
        android:color="@color/hairline" />
    <corners android:radius="14dp" />
</shape>
