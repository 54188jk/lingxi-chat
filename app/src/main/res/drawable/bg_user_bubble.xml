<?xml version="1.0" encoding="utf-8"?>
<!-- 用户气泡：抬起来 5dp，墨黑斜向渐变（深色主题反成白底），右下收小做尾巴 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_solid_ripple">
    <item
        android:id="@android:id/mask"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="8dp"
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_shadow" />
                    <corners
                        android:bottomLeftRadius="22dp"
                        android:bottomRightRadius="12dp"
                        android:topLeftRadius="22dp"
                        android:topRightRadius="22dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_shadow_near" />
                    <corners
                        android:bottomLeftRadius="21dp"
                        android:bottomRightRadius="10dp"
                        android:topLeftRadius="21dp"
                        android:topRightRadius="21dp" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="@color/user_bubble_end"
                        android:startColor="@color/user_bubble_start"
                        android:type="linear" />
                    <corners
                        android:bottomLeftRadius="20dp"
                        android:bottomRightRadius="8dp"
                        android:topLeftRadius="20dp"
                        android:topRightRadius="20dp" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:gravity="top"
                android:height="1dp"
                android:left="18dp"
                android:right="18dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_highlight" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
