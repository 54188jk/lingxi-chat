<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮：实心渐变小圆角 + 发丝描边 + 涟漪，配 btn_solid_fg 文字 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_solid_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/user_bubble_end"
                android:startColor="@color/btn_solid"
                android:type="linear" />
            <stroke
                android:width="0.5dp"
                android:color="@color/card_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
