<?xml version="1.0" encoding="utf-8"?>
<!-- 欢迎页建议行：抬起来 4dp，顶缘高光，点了就当把这句话发出去 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_accent">
    <item
        android:id="@android:id/mask"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_shadow" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="1.5dp"
                android:right="1.5dp"
                android:top="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_shadow_near" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface" />
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/card_stroke" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:gravity="top"
                android:height="1dp"
                android:left="12dp"
                android:right="12dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_highlight" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
