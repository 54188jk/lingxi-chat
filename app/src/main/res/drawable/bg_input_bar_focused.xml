<?xml version="1.0" encoding="utf-8"?>
<!-- 输入栏聚焦：抬起来 5dp + 主色描边 + 内侧一圈主色柔光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="2.5dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow_near" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/accent" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.06"
                android:endColor="@android:color/transparent"
                android:gradientRadius="170dp"
                android:startColor="@color/glow_accent"
                android:type="radial" />
            <stroke
                android:width="0.5dp"
                android:color="@color/accent_soft" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
