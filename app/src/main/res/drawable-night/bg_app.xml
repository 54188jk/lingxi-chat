<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>

    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="top|start"
        android:left="-140dp"
        android:top="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:startColor="#3DF2566B"
                android:centerColor="#1A9F1239"
                android:endColor="#000B1210" />
        </shape>
    </item>

    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="bottom|end"
        android:right="-120dp"
        android:bottom="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:startColor="#33FB7185"
                android:centerColor="#149F1239"
                android:endColor="#000B1210" />
        </shape>
    </item>

    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="center|end"
        android:right="-100dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:startColor="#1FFDA4AF"
                android:endColor="#000B1210" />
        </shape>
    </item>

</layer-list>