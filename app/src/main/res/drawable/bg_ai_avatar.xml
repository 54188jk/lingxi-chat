<?xml version="1.0" encoding="utf-8"?>
<!-- 头像圆环：底盘微渐变 + 外圈发丝 + 内圈一道主色细环，按下有水波 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_accent">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/code_bg"
                        android:startColor="@color/surface"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/card_stroke" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/badge_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
